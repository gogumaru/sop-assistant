# Salin ke .env (make setup melakukannya otomatis jika .env belum ada).

# --- LLM ---
# ollama (default, on-device) atau openai_compat (LM Studio / provider OpenAI-compatible)
LLM_ENGINE=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_TIMEOUT=120

# --- Qdrant ---
# Isi URL untuk server Docker (make qdrant-up).
# Kosongkan (QDRANT_URL=) untuk mode embedded tanpa Docker; data disimpan di QDRANT_PATH.
QDRANT_URL=http://localhost:6333
QDRANT_PATH=data/qdrant_local
QDRANT_COLLECTION=sop_chunks

# --- Embedding ---
EMBED_MODEL=BAAI/bge-m3
# cpu paling aman. Coba mps untuk mempercepat; kembali ke cpu jika error.
EMBED_DEVICE=cpu
EMBED_FP16=false
# Set 1 setelah make models selesai, untuk membuktikan semua jalan offline.
HF_HUB_OFFLINE=0

# --- OCR ---
OCR_LANG=ind
OCR_DPI=300
# Halaman dengan teks lebih pendek dari ini dianggap tidak punya text layer.
OCR_MIN_CHARS=50

# --- Retrieval & guard ---
RETRIEVE_K=5
PREFETCH_LIMIT=20
# Kosong = dibaca dari eval/calibration.json (hasil make calibrate, M4).
ABSTAIN_THRESHOLD=
